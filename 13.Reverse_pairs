class Solution:
    def reversePairs(self, nums: List[int]) -> int:
        def merge(arr,l,mid,r):
            count=0
            temp=[]
            i=l
            j=mid+1
            while i<=mid and j<=r:
                if arr[i]<=arr[j]:
                    temp.append(arr[i])
                    i+=1
                else:
                    temp.append(arr[j])
                    j+=1
            while i<=mid:
                temp.append(arr[i])
                i+=1
            while j<=r:
                temp.append(arr[j])
                j+=1
            for k in range(len(temp)):
                arr[l+k]=temp[k]
        def countPairs(arr,l,mid,r):
            count=0
            j=mid+1
            for i in range(l,mid+1):
                while j<=r and arr[i]>2*arr[j]:
                    j+=1
                count+=j-(mid+1)
            return count
        def mergeSort(arr,l,r):
            if l>=r:
                return 0
            mid=(l+r)//2
            count=0
            count+=mergeSort(arr,l,mid)
            count+=mergeSort(arr,mid+1,r)
            count+=countPairs(arr,l,mid,r)
            merge(arr,l,mid,r)
            return count
        return mergeSort(nums,0,len(nums)-1)    




        
